# 复制为 .env 并填入你的百炼 API Key
DASHSCOPE_API_KEY=sk-xxxx

# 北京地域默认域名；也可以换成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

TEXT_MODEL=qwen-plus
IMAGE_MODEL=qwen-image-3.0
IMAGE_SIZE=2048*1152

# 同时生成的页数
CONCURRENCY=3

# 设为 1 时不调用任何 API，使用占位结果演示流程
MOCK_MODE=0

# 访问登录（HTTP Basic）。两项都填写才会启用；部署到服务器时强烈建议填写
AUTH_USER=
AUTH_PASSWORD=

# ---- 以下仅 Docker Compose 部署使用 ----
# 服务器上对外暴露的端口
PUBLISH_PORT=8765
# 默认使用官方的 Docker Hub 和 PyPI。仅当服务器构建时下载很慢或失败，才需要换成国内镜像源：
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
#   PYTHON_IMAGE=<镜像站地址>/library/python:3.12-slim   （镜像站以公司或云厂商提供的为准）
PYTHON_IMAGE=python:3.12-slim
PIP_INDEX_URL=https://pypi.org/simple
