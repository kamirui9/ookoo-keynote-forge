# 复制为 .env 并填入你的百炼 API Key
DASHSCOPE_API_KEY=sk-xxxx

# 北京地域默认域名；也可以换成 https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

TEXT_MODEL=qwen3.8-max
IMAGE_MODEL=qwen-image-3.0
IMAGE_SIZE=2048*1152

# 同时生成的页数
CONCURRENCY=3

# 设为 1 时不调用任何 API，使用占位结果演示流程
MOCK_MODE=0
